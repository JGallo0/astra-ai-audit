# =========================================================
# OPENAI / MODELO
# =========================================================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1

# =========================================================
# VECTOR STORES
# =========================================================
PROJECT_VECTOR_STORE_ID=your_project_vector_store_id_here
METHODOLOGY_VECTOR_STORE_ID=your_methodology_vector_store_id_here

# =========================================================
# VISUAL / BRANDING
# =========================================================
AUDITORIA_LOGO_PATH=assets/auditoria_logo.png

# =========================================================
# AUTHENTICATION / ACCESS CONTROL
# =========================================================
# true = exige login real
# false = permite entrar sem login se ALLOW_LOCAL_BYPASS=true
AUTH_REQUIRED=false

# true = permite usuário local fictício para desenvolvimento
# false = desliga bypass local
ALLOW_LOCAL_BYPASS=true

# e-mails específicos autorizados (separados por vírgula)
ALLOWED_EMAILS=joao@astracarbon.com,lucas@astracarbon.com,barrosgallo@gmail.com,galloflorestas@gmail.com

# admins
ADMIN_EMAILS=joao@astracarbon.com

# domínios autorizados para clientes piloto
ALLOWED_DOMAINS=

# domínios internos
INTERNAL_DOMAINS=astracarbon.com

# papel padrão para usuários liberados e não internos/admin
DEFAULT_ROLE=pilot_client

# =========================================================
# USAGE LIMITS
# =========================================================
ADMIN_CHAT_LIMIT=9999
ADMIN_FULL_AUDIT_LIMIT=9999

INTERNAL_CHAT_LIMIT=500
INTERNAL_FULL_AUDIT_LIMIT=50

PILOT_CHAT_LIMIT=50
PILOT_FULL_AUDIT_LIMIT=5

# =========================================================
# DATABASE
# Preencha apenas quando o banco estiver configurado.
# Se ficar vazio, o app continua funcionando sem persistência DB.
# =========================================================
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSLMODE=require
